<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct access to existing files, directories, or api scripts
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Rewrite legacy cached asset requests to standard app.js / app.css
  RewriteRule ^assets/index-.*\.js$ assets/app.js [L]
  RewriteRule ^assets/index-.*\.css$ assets/app.css [L]

  # 3. Rewrite all other requests to index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>
