<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect any legacy/cached asset requests to the current production bundle
  RewriteRule ^assets/index-.*\.js$ assets/index-fZpIP8yr.js [L]
  RewriteRule ^assets/index-.*\.css$ assets/index-BCfcgf6M.css [L]

  # Allow direct access to existing files, directories, or api scripts
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other requests (such as /admin, /services) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
