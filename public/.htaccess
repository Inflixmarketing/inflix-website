<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect any legacy/cached asset requests to static app.js and app.css
  RewriteRule ^assets/index-.*\.js$ assets/app.js [L]
  RewriteRule ^assets/index-.*\.css$ assets/app.css [L]

  # Allow direct access to existing files, directories, or api scripts
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
